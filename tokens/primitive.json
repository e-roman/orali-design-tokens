      "$value": "500ms"
    },
    "slower": {
      "$value": "1000ms"
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": {
      "$value": [
        0.4,
        0,
        0.2,
        1
      ]
    },
    "out": {
      "$value": [
        0,
        0,
        0.2,
        1
      ]
    }
