      },
      "fg": {
        "$type": "color",
        "$value": "{color.action.primary.fg}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.full}"
      },
      "height": {
        "$type": "dimension",
        "$value": "{size.control.lg}"
      },
      "padding-x": {
        "$type": "dimension",
        "$value": "{space.8}"
